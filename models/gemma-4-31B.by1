# ── gemma-4-31b.by1 ─────────────────────────────────────────────────
# 验收 #2。压测：同一模型内多种层形状 + 结构属性改张量集合 + 位置按层类型分区。
#
# 事实来源（逐项核对，非二手转述）：
#   refs/gemma-4-31B.config.json    官方 config.json
#   refs/gemma-4-31B.tensors.json   1188 个权重的 dtype 与 shape（从 safetensors 头解析）
#
# 官方 config 里 layer_types 是一个 60 项的显式数组，rope_parameters 按层类型键控。
# 下面一行 pattern 与一个 position 块就是它们的等价物。
# by1-model: gemma-4-31B
# by1-repo:  google/gemma-4-31B
# by1-short: gemma-4-31B

model gemma-4-31B {
  arch    gemma4
  license apache-2.0
  ctx     262144

  hparams {
    d_model = 5376
    n_layer = 60
    vocab   = 262144
    d_ff    = 21504
    act     = gelu_pytorch_tanh
    rms_eps = 1e-06
  }

  # ── 机制库 ────────────────────────────────────────────────────────
  # 局部层与全局层是同一个 mech 的两个「结构属性等价类」：
  #   window                行为属性 —— 只改 mask（1024 vs 全量）
  #   kv / head_dim         结构属性 —— 改 K/V 形状
  #   out_dim               结构属性 —— 注意力宽度不等于 d_model
  #   kv_tie                结构属性 —— K=V。config 里是模型级开关
  #                         attention_k_eq_v，但实测只有 10 个全注意力层没有 v_proj：
  #                         层 5,11,17,23,29,35,41,47,53,59。所以效果是按类分的。
  mech GQA : Attention {
    heads      = { q = 32, kv = 16, head_dim = 256 }
    out_dim    = 8192                 # = q * head_dim
    qk_norm    = true
    kv_tie     = false
    attn_bias  = false
    structural = [ kv, head_dim, out_dim, kv_tie ]
  }

  mech Dense : FFN { hidden = 21504 }

  # ── 调度 ──────────────────────────────────────────────────────────
  schedule {
    local  = 5 * GQA(window = 1024, kv = 16, head_dim = 256, out_dim = 8192,
                      kv_tie = false)
    global = 1 * GQA(window = none, kv = 4,  head_dim = 512, out_dim = 16384,
                     kv_tie = true)
    block  = local + global
  }

  stack main {
    pattern = 10 * block          # 60 层 = 50 局部 + 10 全局，末层是全局
    main[:] >> Dense
  }

  # ── 位置：官方 config 就是用「层类型」键控 rope_parameters ────────
  #   full_attention    : proportional, partial_rotary_factor 0.25, theta 1e6
  #   sliding_attention : default, theta 1e4
  position {
    local  = rope(base = 10000, type = default)
    global = partial(rope(base = 1000000, type = proportional), ratio = 0.25)
  }

  # ── 视觉塔 ────────────────────────────────────────────────────────
  #
  # 量自 `refs/google__gemma-4-31B.tensors.json`（**356 个视觉张量**）：
  # 27 层，**每层 13 个、27 层完全一致**，形状和文本层同一个式子 ——
  # 只是宽度 1152、hidden 4304、q = kv = 16、head_dim 72（16×72 = 1152 ✓）。
  # **机制全是现成的**：`Attention` + `qk_norm` + `FFN`，不需要新种类 ✓。
  mech ViT : Attention {
    heads      = { q = 16, kv = 16, head_dim = 72 }
    out_dim    = 1152                 # = q * head_dim
    qk_norm    = true
    attn_bias  = false
    structural = [ head_dim, out_dim ]
  }

  mech ViTMlp : FFN { hidden = 4304 }

  # **这个栈有自己的宽度。** 视觉塔宽 1152，而模型的 `d_model` 是 5376 ——
  # 张量形状里的 `d_model` 原来只有模型级那一个，所以这一栈的张量
  # **写不出来** ✗（356 个视觉张量，一个都声明不了）。
  # 现在 `stack` 可以带一个 `d_model`（见 `by1stacks` 里那段）。
  #
  # `aux = true`：它**不是解码层**，所以不进 `n_layer` 的合计 ——
  # 和 MTP 栈同一个理由 ✓。
  #
  # **每层四个 norm 不用声明** —— `input_layernorm` /
  # `post_attention_layernorm` / `pre_feedforward_layernorm` /
  # `post_feedforward_layernorm` 来自内建的层规则，而 `by1verify`
  # 已经在文本那 530 个张量上验过这条规则 ✓。
  stack vision {
    d_model = 1152
    aux     = true
    pattern = 27 * ViT
    vision[:] >> ViTMlp
  }

  # 视觉塔的张量契约 —— 形状和文本层同一个式子，只是 `d_model` 由
  # 上面那个栈给（1152）。
  tensors {
    GQA {
      q_proj.weight : (q * head_dim, d_model)
      k_proj.weight : (kv * head_dim, d_model)
      v_proj.weight : (kv * head_dim, d_model) unless kv_tie
      o_proj.weight : (d_model, q * head_dim)
      q_norm.weight : (head_dim,)
      k_norm.weight : (head_dim,)
    }
    Dense {
      gate_proj.weight : (hidden, d_model)
      up_proj.weight   : (hidden, d_model)
      down_proj.weight : (d_model, hidden)
    }
    ViT {
      # **逻辑名里带 `.linear`。** 官方的视觉张量叫
      # `self_attn.q_proj.linear.weight` —— 比文本那边多一层。
      # 而命名模板加的是 `.weight`，所以中间那层只能写在逻辑名里。
      # （契约里带点的逻辑名本来就有先例：`shared_experts.gate_proj.weight`。）
      #
      # 层内那四个 norm **不走这条** —— 它们来自内建的 `LAYER_DEFAULT`，
      # 名字是 `input_layernorm.weight`，没有 `.linear` ✓。
      q_proj.linear.weight : (q * head_dim, d_model)
      k_proj.linear.weight : (kv * head_dim, d_model)
      v_proj.linear.weight : (kv * head_dim, d_model)
      o_proj.linear.weight : (d_model, q * head_dim)
      q_norm.weight        : (head_dim,)
      k_norm.weight        : (head_dim,)
    }
    ViTMlp {
      gate_proj.linear.weight : (hidden, d_model)
      up_proj.linear.weight   : (hidden, d_model)
      down_proj.linear.weight : (d_model, hidden)
    }
    layer {
      input_layernorm.weight            : (d_model,)
      post_attention_layernorm.weight   : (d_model,)
      pre_feedforward_layernorm.weight  : (d_model,)
      post_feedforward_layernorm.weight : (d_model,)
      # **没有 .weight 后缀的那个。** 换成标准约定（逻辑名带 .weight、
      # 模板用 {scope}{physical}）之后，这种张量才表达得出来 ——
      # 旧的 `{logical}.weight` 模板会把它渲染成 layer_scalar.weight ✗。
      layer_scalar                      : (1,) unless Dense
    }
  }

  # ── 附属 ──────────────────────────────────────────────────────────
  # config: num_kv_shared_layers = 0 —— 本模型不做跨层 KV 复用。
  # config: tie_word_embeddings = true —— 权重里确实没有 lm_head。
  head LmHead { tie_embedding = true, logit_softcap = 30.0 }
  head Draft  { kind = speculative }

  # ── 视觉塔：**量清楚了，而它还写不出来** ──────────────────────────
  #
  # 这里原来是一段 `vision ViT { ... }` —— 而 `vision` 不是这个语言
  # 认识的顶层关键字，**那一段从来没被读过** ✗（实测：删掉它，`check()`
  # 的 24 个输出键里唯一变化的是行号）。
  #
  # 后来量了一遍官方产物（`refs/google__gemma-4-31B.tensors.json`，
  # **356 个视觉张量**），结果如下：
  #
  #   vision_tower.encoder.layers.{0..26}   27 层，**每层 13 个，27 层一致**
  #     input_layernorm.weight                       [1152]
  #     post_attention_layernorm.weight              [1152]
  #     pre_feedforward_layernorm.weight             [1152]
  #     post_feedforward_layernorm.weight            [1152]
  #     self_attn.{q,k,v,o}_proj.linear.weight       [1152, 1152]
  #     self_attn.{q,k}_norm.weight                  [72]
  #     mlp.{gate,up}_proj.linear.weight             [4304, 1152]
  #     mlp.down_proj.linear.weight                  [1152, 4304]
  #   patch_embedder.input_proj.weight               [1152, 768]
  #   patch_embedder.position_embedding_table        [2, 10240, 1152]
  #   std_bias / std_scale                           [1152]
  #   embed_vision.embedding_projection.weight       [5376, 1152]
  #
  # **形状和文本层是同一个**（四个 norm 的位置也一样，Gemma 式三明治），
  # 机制全是现成的：`Attention` + `qk_norm` + `FFN`。
  #
  # 我照着写了一个 `ViT` / `ViTMlp` / `stack vision`，它**解析得过**：
  #
  #     mechs  = {GQA, Dense, ViT, ViTMlp}
  #     stacks = [('main', '', 60), ('vision', '', 27)]
  #
  # 而**契约写不出来** —— 卡在一处具体的语言缺口：
  #
  #     张量形状里的 `d_model` 是**模型级**的（5376），
  #     而视觉塔宽 **1152**。`out_dim` 只管"注意力输出宽度 ≠ d_model"，
  #     **没有"给一个栈自己的输入宽度"的写法** ✗。
  #
  # 所以"能描述"这一步的真实前置不是"再写一段 .by1" ✓，
  # 而是**给 stack 加一个宽度** —— 一行语言改动 ✓。
  #
  # 那一步做完，判卷人是现成的：
  #     by1verify gemma-4-31B.by1 refs/google__gemma-4-31B.config.json \
  #               --tensors refs/google__gemma-4-31B.tensors.json
  # 现在它覆盖的是文本主干（530 个），视觉那 356 个一个没查 ✓。

  # ── 后端：物理命名与 config 字段都由这里生成 ──────────────────────
  emit {
    # 产物三：transformers 的 config.json —— 这次由 .by1 生成，不继承任何字段
    train -> transformers.config {
      field {
        model_type              = "gemma4_text"
        hidden_size             = d_model
        num_hidden_layers       = n_layer
        vocab_size              = vocab
        intermediate_size       = d_ff
        hidden_activation       = act
        rms_norm_eps            = rms_eps
        max_position_embeddings = ctx
        num_attention_heads     = GQA.q
        head_dim                = GQA[window != none].head_dim
        global_head_dim         = GQA[window = none].head_dim
        num_key_value_heads     = GQA[window != none].kv
        num_global_key_value_heads = GQA[window = none].kv
        attention_k_eq_v        = GQA[window = none].kv_tie
        sliding_window          = GQA[window != none].window
        attention_bias          = GQA.attn_bias
        attention_dropout       = 0.0
        layer_types             = schedule
        rope_parameters         = position
        tie_word_embeddings     = LmHead.tie_embedding
        final_logit_softcapping = LmHead.logit_softcap
        vocab_size_per_layer_input = vocab
        num_kv_shared_layers    = 0
        hidden_size_per_layer_input = 0
        enable_moe_block        = false
        use_double_wide_mlp     = false
        use_bidirectional_attention = "vision"
        use_cache               = true
        num_experts             = null
        expert_intermediate_size = null
        top_k_experts           = null
        initializer_range       = 0.02
        dtype                   = "bfloat16"
        bos_token_id            = 2
        eos_token_id            = 1
        pad_token_id            = 0
      }
    }

    # 权威产物：HuggingFace safetensors
    train -> torch.module {
      name  = "model.language_model.layers.{i}.{scope}{physical}"
      # 辅助栈可以有自己的前缀（`render_name` 的优先级是
      # `expert_name > name_<栈名> > name`，Nemotron 的
      # `name_model` / `name_mtp` 就是这么用的）。视觉塔只差这一条 ✓。
      name_vision = "model.vision_tower.encoder.layers.{i}.{scope}{physical}"
      #
      # ⚠ **`layer` / `global` 这两行我试过、撤了。** 试的写法是
      #
      #     scope { ..., layer = "", global = "" }
      #
      # 而它把**物理名**也改了 —— `scope` 的值不只用于这里的模板，
      # 也参与别处的物理名。表现是"契约声明了 1210 个、只有 2 个对得上"。
      #
      # 真要补上那 355 个张量（Gemma 每层四个 norm + `layer_scalar`
      # + `embed`/`final_norm`），得先分清 `scope` 的两种用途 ——
      # 那是一件**要读懂 `by1check` 里 `scope` 怎么被消费**的活，
      # 而不是往这里加两行 ✓。
      #
      # ⚠ **`layer` 块：试过，成了大半，又撤了。** 记下量到的东西，
      # 免得下一个人重走。
      #
      # ① **`layer` 必须也在 `scope` 映射里。** `by1verify` 按 owner 查
      #    这张表，不在表里就记成"未映射"直接跳过 ✗ —— 少一行，
      #    `layer` 块里声明的东西**一个都验不到**，
      #    而表现是"未覆盖数一点没变"，看起来像声明没生效 ✓。
      #
      # ② **逻辑名要写裸名。** 模板会加 `.weight` —— 写
      #    `input_layernorm.weight` 会渲染成
      #    `...input_layernorm.weight.weight` ✗。
      #    （这条是**看渲染出来的名字**才发现的，读代码看不出来 ✓。）
      #
      # ③ **`layer_scalar` 表达不了** ✗ —— 它的官方名字
      #    `...layers.N.layer_scalar` **没有 `.weight` 后缀**，
      #    而模板无条件加。要它得有一条"不加后缀"的规则。
      #
      # 做了 ① ② 之后：**未覆盖 415 -> 67** ✓，而**多出 108 个形状不符** ✗
      # —— 视觉那 27 x 4 个 norm：`layer` 行只算一次、用的是模型的
      # `d_model`（5376），而视觉栈宽 1152。class 行没这个问题
      # （逐实例算 ✓），`layer` 行有。
      #
      # 我补了一张按栈的 `layer_rows_by_stack` ✓，而**它没生效** ✗ ——
      # `layer_out` 里仍是 5376。原因没查到，那一版会让门变红，所以撤了。
      #
      # **要接着做，入口是两处**：`by1tens` 的 `layer_rows`（只算一次）、
      # 和 `by1check` 里逐层拼 `layer_out` 那一段。
      scope { GQA = self_attn., Dense = mlp., ViT = self_attn., ViTMlp = mlp., layer = "", global = "" }
    }

    # 推理产物：GGUF
    infer -> ggml {
      name  = "blk.{i}.{scope}_{physical}.weight"
      # **`rename` 的键是逻辑名，而逻辑名现在带 `.weight`。**
      # 换成标准约定（逻辑名含 `.weight`、模板用 `{scope}{physical}`）之后，
      # 这里的键也得跟着带 —— 否则一条都查不到，
      # 而表现是"530 个声明、**0 个对上**" ✗。
      #
      # （`name` 里那个 `.weight` 不动：`physical` 现在只是 `q` 这样的短名，
      #   后缀仍由模板给 ✓。）
      scope { GQA = attn, Dense = ffn }
      rename {
        q_proj.weight = q, k_proj.weight = k, v_proj.weight = v,
        o_proj.weight = output,
        gate_proj.weight = gate, up_proj.weight = up,
        down_proj.weight = down,
        # `blk.N.attn_q_norm.weight` —— 这两条原来漏了，
        # 于是渲染成 `…attn_q_norm.weight.weight`（双后缀）✗，
        # 60 层 x 2 = 120 个"缺失" ✓。
        q_norm.weight = q_norm, k_norm.weight = k_norm
      }
    }
  }
}
