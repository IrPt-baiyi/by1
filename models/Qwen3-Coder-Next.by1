# ── Qwen3-Coder-Next.by1 ─────────────────────────────────────────────
# Qwen/Qwen3-Coder-Next —— Qwen3-Next 骨架的**代码向**号。
#
# 它是这个仓库里**第一个"逐专家存储"的真实模型**（前面几个都是融合存储），
# 也是第一个 `in_proj` **两块融合**的线性注意力：
#
#   ① 线性注意力的投影是**融合的**（和 Qwen3.5 那一族不一样）：
#        `in_proj_qkvz (12288, 2048)` = qkv(8192) + z(4096)  ← 一块
#        `in_proj_ba   (64, 2048)`    = a(32) + b(32)         ← 另一块
#      （Qwen3.5 是四块分开：`in_proj_qkv` / `_z` / `_a` / `_b`）
#
#   ② MoE 的专家是**逐个存的** —— `mlp.experts.{e}.gate_proj.weight`，
#      512 个专家各三个 Linear。所以契约用 `per_expert`：
#      形状侧写**打包形状**（第一维 = 专家数），名字侧由 `expert_name` 展开。
#      （Qwen3.6-35B-A3B 是融合的 `experts.gate_up_proj` —— **相反**。）
#
#   ③ **没有 MTP、没有视觉塔** —— 48 层全是 MoE，没有稠密 FFN
#      （checkpoint 里根本没有 `mlp.down_proj.weight`；config 里那个
#       `intermediate_size = 5120` 是**遗留字段**，没有任何张量对得上它）。
#
#   ④ config 是**扁平的**（`qwen3_next`，不是 `qwen3_5` 那种嵌套
#      `text_config`），而且**没有 `layer_types`** —— 混合方式由
#      `full_attention_interval = 4` 说（3 线性 + 1 全量）。
#
# 全量注意力 `q x head_dim = 16 x 256 = 4096` ≠ d_model 2048 → 显式 `out_dim`。
#
# 事实来源：
#   refs/Qwen__Qwen3-Coder-Next.config.json
#   refs/Qwen__Qwen3-Coder-Next.tensors.json（74391 个张量）
# by1-model: Qwen3-Coder-Next
# by1-repo:  Qwen/Qwen3-Coder-Next
# by1-short: Qwen3-Coder-Next

model Qwen3-Coder-Next {
  arch  qwen3_next
  ctx   262144

  hparams {
    d_model = 2048
    n_layer = 48
    vocab   = 151936
    rms_eps = 1e-06
  }

  # GDN 线性注意力：16 头 k、**32 头 v**，都是 128 维，卷积核 4。
  # 投影是**两块融合**的 —— 见契约里那两行（不是 Qwen3.5 的四块）。
  mech Lin : Linear {
    k_heads     = 16
    k_dim       = 128
    v_heads     = 32
    v_dim       = 128
    conv_kernel = 4
    act         = silu
    structural  = [ k_heads, k_dim, v_heads, v_dim, conv_kernel, out_dim ]
  }

  # 全量注意力：16 头 x 256 = 4096（d_model 的两倍），输出门控。
  mech GQA : Attention {
    heads      = { q = 16, kv = 2, head_dim = 256 }
    out_dim    = 4096
    q_gate     = true
    qk_norm    = per_head
    structural = [ head_dim, out_dim, q_gate, qk_norm ]
  }

  # ── MoE：**逐专家存储** + 共享专家 + 共享专家门控 ────────────────
  # 实测：mlp.experts.{e}.gate_proj.weight [512, 2048]（512 个）
  #       mlp.gate.weight                 [512, 2048]   ← 路由器
  #       mlp.shared_expert_gate.weight   [1, 2048]
  mech MoE : MoE {
    experts       = 512
    top_k         = 10
    hidden        = 512
    shared        = 1
    shared_hidden = 512
    shared_gate   = true
    routing       = softmax_topk
    layer_kind    = sparse
    structural    = [ experts, hidden, shared_hidden, shared_gate ]
  }

  schedule {
    lin   = 3 * Lin
    full  = 1 * GQA
    block = lin + full
  }

  stack model {
    pattern = 12 * block           # 48 层 = 12 × 4
    model[:] >> MoE
  }

  position {
    default = partial(rope(base = 5000000, pairing = half), ratio = 0.25)
  }

  tensors {
    Lin {
      # **两块融合**：
      #   qkvz = qkv(k*2 + v) + z(v) —— **z 那一半也算在里面**，
      #          16*128*2 + 32*128 + 32*128 = 4096 + 4096 + 4096 = 12288 ✓
      #          （第一版漏了 z，写成 8192，36 个线性层全报"形状不符"）
      #   ba   = a(v) + b(v) = 64 ✓
      # 而 `conv1d` **只有 qkv 那一半**（8192）—— 卷积不碰 z。
      in_proj_qkvz.weight : (k_heads * k_dim * 2 + v_heads * v_dim * 2, d_model)
      in_proj_ba.weight   : (v_heads * 2, d_model)
      conv1d.weight       : (k_heads * k_dim * 2 + v_heads * v_dim, 1, conv_kernel)
      A_log               : (v_heads,)
      dt_bias             : (v_heads,)
      norm.weight         : (v_dim,)
      out_proj.weight     : (d_model, v_heads * v_dim)
    }
    GQA {
      q_proj.weight : (q * head_dim * 2, d_model)
      k_proj.weight : (kv * head_dim, d_model)
      v_proj.weight : (kv * head_dim, d_model)
      o_proj.weight : (d_model, q * head_dim)
      q_norm.weight : (head_dim,)
      k_norm.weight : (head_dim,)
    }
    # 专家**逐个存**：契约写打包形状 + `per_expert`（检查器会去掉第一维
    # 再逐个比）。逻辑名里不写 `experts.` —— 那一段由 `expert_name` 模板补。
    MoE {
      gate.weight                    : (experts, d_model)
      gate_proj.weight               : (experts, hidden, d_model) per_expert
      up_proj.weight                 : (experts, hidden, d_model) per_expert
      down_proj.weight               : (experts, d_model, hidden) per_expert
      shared_expert.gate_proj.weight : (shared_hidden, d_model)
      shared_expert.up_proj.weight   : (shared_hidden, d_model)
      shared_expert.down_proj.weight : (d_model, shared_hidden)
      shared_expert_gate.weight      : (1, d_model)
    }
    layer {
      input_layernorm.weight          : (d_model,)
      post_attention_layernorm.weight : (d_model,)
    }
    global {
      embed.weight      : (vocab, d_model)
      final_norm.weight : (d_model,)
      # tie = false —— 顶层字段，`lm_head` 在。
      lm_head.weight    : (vocab, d_model)
    }
  }

  emit {
    train -> transformers.config {
      field {
        model_type                  = "qwen3_next"
        vocab_size                  = vocab
        hidden_size                 = d_model
        num_hidden_layers           = n_layer
        # ⚠ **遗留字段**：checkpoint 里**没有任何张量**对得上它
        # （48 层全是 MoE，没有稠密 FFN）。但官方 config 里写着，就得写。
        intermediate_size           = 5120
        num_attention_heads         = GQA.q
        num_key_value_heads         = GQA.kv
        head_dim                    = GQA.head_dim
        max_position_embeddings     = ctx
        rms_norm_eps                = rms_eps
        hidden_act                  = "silu"
        attention_bias              = false
        attention_dropout           = 0
        initializer_range           = 0.02
        # 扁平 config —— `rope_theta` / `partial_rotary_factor` 是**平铺**的
        # （不是 Qwen3.5 那种嵌在 `rope_parameters` 里的）。
        rope_theta                  = 5000000
        partial_rotary_factor       = 0.25
        rope_scaling                = null
        use_cache                   = true
        use_sliding_window          = false
        full_attention_interval     = 4
        linear_conv_kernel_dim      = 4
        linear_key_head_dim         = 128
        linear_num_key_heads        = 16
        linear_num_value_heads      = 32
        linear_value_head_dim       = 128
        mlp_only_layers             = []
        decoder_sparse_step         = 1
        moe_intermediate_size       = MoE.hidden
        num_experts                 = MoE.experts
        num_experts_per_tok         = MoE.top_k
        shared_expert_intermediate_size = MoE.shared_hidden
        norm_topk_prob              = true
        output_router_logits        = false
        router_aux_loss_coef        = 0.001
        tie_word_embeddings         = false
        bos_token_id                = 151643
        eos_token_id                = 151645
      }
    }

    train -> torch.module {
      name        = "model.layers.{i}.{scope}{physical}"
      expert_name = "model.layers.{i}.{scope}experts.{expert}.{physical}"
      global_name = "{physical}"
      scope { Lin = linear_attn., GQA = self_attn., MoE = mlp., layer = "", global = "" }
      rename {
        embed.weight      = model.embed_tokens.weight,
        final_norm.weight = model.norm.weight
      }
    }
  }
}
