    }
  }

  emit {
    train -> transformers.config {
      field {
        model_type                  = "qwen4_exp_text"
        vocab_size                  = vocab
        hidden_size                 = d_model
        num_hidden_layers           = n_layer
        # MoE 号 —— 没有 `intermediate_size`。
        num_attention_heads         = GQA.q
        num_key_value_heads         = GQA.kv
        head_dim                    = GQA.head_dim
        max_position_embeddings     = ctx
        rms_norm_eps                = rms_eps
        hidden_act                  = "silu"
        attention_bias              = false
        attention_dropout           = 0.0
        initializer_range           = 0.02
        rope_parameters             = {"mrope_interleaved": true, "mrope_section": [11, 11, 10], "partial_rotary_factor": 0.25, "rope_theta": 10000000, "rope_type": "default"}
        partial_rotary_factor       = 0.25
        use_cache                   = true
        layer_types                 = layer_types
        full_attention_interval     = 4
        output_gate_type            = "sigmoid"
        linear_conv_kernel_dim      = 4
        linear_key_head_dim         = 128
        linear_num_key_heads        = 16
        linear_num_value_heads      = 48
        linear_value_head_dim       = 128
        mamba_ssm_dtype             = "float32"
        # ── MoE ──
        moe_intermediate_size       = MoE.hidden
        num_experts                 = MoE.experts
        num_experts_per_tok         = MoE.top_k
        shared_expert_intermediate_size = MoE.shared_hidden
        router_aux_loss_coef        = 0.001
        output_router_logits        = false
        # ── mHC ──
        hc_count                    = hc_count
        hc_lowrank                  = hc_lowrank
        # ── 稀疏索引器 ──
        indexer_budget              = 2048
        indexer_compress_ratio      = 4
        indexer_head_dim            = 128
        indexer_kv_heads            = 1
        indexer_n_heads             = 4
        # ── PLE / ngram ──
        ple_conv_kernel_size        = 4
        ple_embed_dim               = d_model
        ple_layer_ids               = [2]
        ngram_size                  = 3
        heads_per_ngram             = 8
        ngram_vocab_size_base       = 20000000
        split_ngram_parts           = 128
        make_ngram_vocab_size_divisible_by = 128
        # ── MTP ──
        mtp                         = {"hybrid": true, "layer_types": ["full_attention"], "mtp_use_hidden_state_from_layer": null, "num_hidden_layers": 1, "rope_theta": 10000000}
        mtp_num_hidden_layers       = 1
        mtp_use_dedicated_embeddings = false
        tie_word_embeddings         = false
        bos_token_id                = 248044
        eos_token_id                = 248044
        pad_token_id                = null
      }
    }

    train -> torch.module {
      name_model  = "model.language_model.layers.{i}.{scope}{physical}"
      name_mtp    = "mtp.layers.{i}.{scope}{physical}"
      name_visual = "model.visual.blocks.{i}.{scope}{physical}"
      name        = "{stack}.layers.{i}.{scope}{physical}"
      global_name = "{physical}"
      scope { Lin = linear_attn., GQA = self_attn., MoE = mlp., Vis = attn., VisMlp = mlp., layer = "", global = "" }
      rename {
        embed.weight      = model.language_model.embed_tokens.weight,
        mtp_fc_embedding.weight   = mtp.fc_embedding.weight,
        mtp_fc_hidden.weight      = mtp.fc_hidden.weight,
        mtp_norm_embedding.weight = mtp.pre_fc_norm_embedding.weight,
        mtp_norm_hidden.weight    = mtp.pre_fc_norm_hidden.weight
      }
    }
  }
}
