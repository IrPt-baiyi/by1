# ── Qwen3.5-397B-A17B.by1 ────────────────────────────────────────────
# Qwen/Qwen3.5-397B-A17B —— Qwen3.5 家族最大号，也是这一族**唯一的 MoE 号**。
#
# 骨架还是 Qwen3.5 那一套（线性注意力 GDN 3+1 混合 + 输出门控 + 按头 QK-norm
# + MTP + 视觉塔、视觉塔**无 deepstack**），把 9B 的稠密 FFN 换成 MoE：
#
#   d_model 4096 · n_layer 60 · Lin v 头 **64**（k 头仍是 16）·
#   全量注意力 32 头 x 256 = **8192 ≠ d_model**（所以要显式 `out_dim`）·
#   专家 512 选 10 · `moe_intermediate_size = 1024` · 共享专家 1 个（也是 1024）
#   + `shared_expert_gate`（给共享专家的输出再乘一个标量）。
#
# ## ⚠ 这一份真正的难点：**主干的专家和 MTP 的专家存储方式不一样**
#
#   主干（`model.language_model.layers.N.mlp.`）：
#       `experts.gate_up_proj  (512, 2048, 4096)`   ← **融合**，一个 Parameter
#       `experts.down_proj     (512, 4096, 1024)`
#
#   MTP（`mtp.layers.N.mlp.`）：
#       `experts.{e}.gate_proj.weight (1024, 4096)` ← **逐专家拆开**，512 个 Linear
#       `experts.{e}.up_proj.weight   (1024, 4096)`
#       `experts.{e}.down_proj.weight (4096, 1024)`
#
#   同一份 `.by1` 里两种都要有 —— 所以是**两个机制声明**（`MoE` / `MTPMoe`），
#   属性一样、契约不一样。契约是按「机制名 × 结构属性」存的，所以两个名字
#   各拿各的一份。逐专家那一份用 `per_expert`（形状写**打包形状**，
#   名字侧由 `emit` 的 `expert_name` 模板把专家号插进中间）。
#
# 事实来源：
#   refs/Qwen__Qwen3.5-397B-A17B.config.json
#   refs/Qwen__Qwen3.5-397B-A17B.tensors.json（2924 个张量）
# by1-model: Qwen3.5-397B-A17B
# by1-repo:  Qwen/Qwen3.5-397B-A17B
# by1-short: Qwen3.5-397B-A17B

model Qwen3.5-397B-A17B {
  arch  qwen3_5_moe
  ctx   262144

  hparams {
    d_model = 4096
    n_layer = 60
    vocab   = 248320
    rms_eps = 1e-06
    norm    = zero_centered   # 官方 RMSNorm 是 (1+w) 约定（见 by1qknorm 判卷人）
  }

  # GDN 线性注意力：16 头 k、**64 头 v**，都是 128 维，卷积核 4。
  mech Lin : Linear {
    k_heads     = 16
    k_dim       = 128
    v_heads     = 64
    v_dim       = 128
    conv_kernel = 4
    act         = silu
    structural  = [ k_heads, k_dim, v_heads, v_dim, conv_kernel, out_dim ]
  }

  # 全量注意力：32 头 x 256 = 8192（**d_model 的两倍**），输出门控。
  mech GQA : Attention {
    heads      = { q = 32, kv = 2, head_dim = 256 }
    out_dim    = 8192
    q_gate     = true
    qk_norm    = per_head
    structural = [ head_dim, out_dim, q_gate, qk_norm ]
  }

  # ── 主干 MoE：**融合存储** + 共享专家 + 共享专家门控 ──────────────
  # 实测：experts.gate_up_proj [512, 2048, 4096] = (E, 2*1024, d)
  #       experts.down_proj    [512, 4096, 1024] = (E, d, 1024)
  #       shared_expert_gate   [1, 4096]
  mech MoE : MoE {
    experts       = 512
    top_k         = 10
    hidden        = 1024
    shared        = 1
    shared_hidden = 1024
    shared_gate   = true
    routing       = softmax_topk
    layer_kind    = sparse
    structural    = [ experts, hidden, shared_hidden, shared_gate ]
  }

  mech MTPAttn : Attention {
    heads      = { q = 32, kv = 2, head_dim = 256 }
    out_dim    = 8192
    q_gate     = true
    qk_norm    = per_head
    structural = [ head_dim, out_dim, q_gate, qk_norm ]
  }

  # ── MTP 的 MoE：属性**和主干一模一样**，只有存储方式不同（逐专家）──
  # 所以它必须另起一个机制名 —— 契约是按机制名存的，同名就会被覆盖。
  mech MTPMoe : MoE {
    experts       = 512
    top_k         = 10
    hidden        = 1024
    shared        = 1
    shared_hidden = 1024
    shared_gate   = true
    routing       = softmax_topk
    structural    = [ experts, hidden, shared_hidden, shared_gate ]
  }

  # ── 视觉塔（27 层，宽 1152）—— 和 9B **逐张量同名同形状** ─────────
  mech Vis : Attention {
    qkv_fused  = true
    heads      = { q = 16, kv = 16, head_dim = 72 }
    bias       = true
    structural = [ head_dim ]
  }
  mech VisMlp : FFN { hidden = 4304, gate = none, bias = true }

  schedule {
    lin   = 3 * Lin
    full  = 1 * GQA
    block = lin + full
  }

  stack model {
    pattern = 15 * block           # 60 层 = 15 × 4
    model[:] >> MoE
  }

  stack mtp {
    aux     = true
    pattern = 1 * MTPAttn
    mtp[:] >> MTPMoe
  }

  stack visual {
    d_model = 1152
    aux     = true
    pattern = 27 * Vis
    visual[:] >> VisMlp
  }

  position {
    default = partial(rope(base = 10000000, pairing = half), ratio = 0.25)
  }

  tensors {
    Lin {
      in_proj_qkv.weight : (k_heads * k_dim * 2 + v_heads * v_dim, d_model)
      in_proj_z.weight   : (v_heads * v_dim, d_model)
      in_proj_a.weight   : (v_heads, d_model)
      in_proj_b.weight   : (v_heads, d_model)
      conv1d.weight      : (k_heads * k_dim * 2 + v_heads * v_dim, 1, conv_kernel)
      A_log              : (v_heads,)
      dt_bias            : (v_heads,)
      norm.weight        : (v_dim,)
      out_proj.weight    : (d_model, v_heads * v_dim)
    }
    GQA {
      q_proj.weight : (q * head_dim * 2, d_model)
      k_proj.weight : (kv * head_dim, d_model)
      v_proj.weight : (kv * head_dim, d_model)
      o_proj.weight : (d_model, q * head_dim)
      q_norm.weight : (head_dim,)
      k_norm.weight : (head_dim,)
    }
    MTPAttn {
      q_proj.weight : (q * head_dim * 2, d_model)
      k_proj.weight : (kv * head_dim, d_model)
      v_proj.weight : (kv * head_dim, d_model)
      o_proj.weight : (d_model, q * head_dim)
      q_norm.weight : (head_dim,)
      k_norm.weight : (head_dim,)
    }
    # 主干：**融合存储**（checkpoint 里就是 `experts.gate_up_proj`）。
    MoE {
      gate.weight                    : (experts, d_model)
      experts.gate_up_proj           : (experts, 2 * hidden, d_model)
      experts.down_proj              : (experts, d_model, hidden)
      shared_expert.gate_proj.weight : (shared_hidden, d_model)
      shared_expert.up_proj.weight   : (shared_hidden, d_model)
      shared_expert.down_proj.weight : (d_model, shared_hidden)
      shared_expert_gate.weight      : (1, d_model)
    }
    # MTP：**逐专家拆开**。契约里写的是**打包形状**（第一维是专家数），
    # 检查器看到 `per_expert` 会**自己去掉第一维**再逐个比 —— 所以这里
    # 不能只写单个专家的 `(hidden, d_model)`（那样会先被削成 `(d_model,)`，
    # 报成"契约 [4096] vs 实际 [1024, 4096]"）。
    # 名字侧由 `emit` 的 `expert_name` 把 `{expert}` 插进 `experts.` 和
    # `gate_proj` 之间 —— 所以逻辑名里**不写** `experts.`。
    MTPMoe {
      gate.weight                    : (experts, d_model)
      gate_proj.weight               : (experts, hidden, d_model) per_expert
      up_proj.weight                 : (experts, hidden, d_model) per_expert
      down_proj.weight               : (experts, d_model, hidden) per_expert
      shared_expert.gate_proj.weight : (shared_hidden, d_model)
      shared_expert.up_proj.weight   : (shared_hidden, d_model)
      shared_expert.down_proj.weight : (d_model, shared_hidden)
      shared_expert_gate.weight      : (1, d_model)
    }
    layer {
      input_layernorm.weight          : (d_model,)
      post_attention_layernorm.weight : (d_model,)
    }
    layer visual {
      norm1.weight : (d_model,)
      norm1.bias   : (d_model,)
      norm2.weight : (d_model,)
      norm2.bias   : (d_model,)
    }
    Vis {
      qkv.weight  : (3 * q * head_dim, d_model)
      qkv.bias    : (3 * q * head_dim,)
      proj.weight : (d_model, q * head_dim)
      proj.bias   : (d_model,)
    }
    VisMlp {
      linear_fc1.weight : (hidden, d_model)
      linear_fc1.bias   : (hidden,)
      linear_fc2.weight : (d_model, hidden)
      linear_fc2.bias   : (d_model,)
    }
    global {
      embed.weight      : (vocab, d_model)
      final_norm.weight : (d_model,)
      # tie = false（**只在 config 顶层**，`text_config` 里没有这个键）。
      lm_head.weight    : (vocab, d_model)
      mtp_fc.weight             : (d_model, 2 * d_model)
      mtp_norm_embedding.weight : (d_model,)
      mtp_norm_hidden.weight    : (d_model,)
      mtp_norm.weight           : (d_model,)
      # ── 视觉塔层外（9 个）—— 没有 deepstack；merger 输出宽度是**文本的 d_model**。
      model.visual.patch_embed.proj.weight  : (1152, 3, 2, 16, 16)
      model.visual.patch_embed.proj.bias    : (1152,)
      model.visual.pos_embed.weight         : (2304, 1152)
      model.visual.merger.norm.weight       : (1152,)
      model.visual.merger.norm.bias         : (1152,)
      model.visual.merger.linear_fc1.weight : (4608, 4608)
      model.visual.merger.linear_fc1.bias   : (4608,)
      model.visual.merger.linear_fc2.weight : (d_model, 4608)
      model.visual.merger.linear_fc2.bias   : (d_model,)
    }
  }

  emit {
    train -> transformers.config {
      field {
        model_type                  = "qwen3_5_moe_text"
        vocab_size                  = vocab
        hidden_size                 = d_model
        num_hidden_layers           = n_layer
        # ⚠ **没有 `intermediate_size`** —— 这是 MoE 号，稠密那一栏由
        # `moe_intermediate_size` / `shared_expert_intermediate_size` 说。
        num_attention_heads         = GQA.q
        num_key_value_heads         = GQA.kv
        head_dim                    = GQA.head_dim
        max_position_embeddings     = ctx
        rms_norm_eps                = rms_eps
        hidden_act                  = "silu"
        attention_bias              = false
        attention_dropout           = 0.0
        initializer_range           = 0.02
        rope_parameters             = {"mrope_interleaved": true, "mrope_section": [11, 11, 10], "rope_type": "default", "rope_theta": 10000000, "partial_rotary_factor": 0.25}
        use_cache                   = true
        layer_types                 = layer_types
        full_attention_interval     = 4
        attn_output_gate            = true
        linear_conv_kernel_dim      = 4
        linear_key_head_dim         = 128
        linear_num_key_heads        = 16
        linear_num_value_heads      = 64
        linear_value_head_dim       = 128
        mamba_ssm_dtype             = "float32"
        mlp_only_layers             = []
        moe_intermediate_size       = MoE.hidden
        num_experts                 = MoE.experts
        num_experts_per_tok         = MoE.top_k
        shared_expert_intermediate_size = MoE.shared_hidden
        router_aux_loss_coef        = 0.001
        mtp_num_hidden_layers       = 1
        mtp_use_dedicated_embeddings = false
        eos_token_id                = 248044
      }
    }

    train -> torch.module {
      name_model  = "model.language_model.layers.{i}.{scope}{physical}"
      name_mtp    = "mtp.layers.{i}.{scope}{physical}"
      name_visual = "model.visual.blocks.{i}.{scope}{physical}"
      name        = "{stack}.layers.{i}.{scope}{physical}"
      # 只有 `MTPMoe` 的契约带 `per_expert` —— 主干那一份是融合存储的，
      # 逻辑名本身就是完整物理名，**不会被这个模板碰**（`use_e` 只在
      # 标了 `per_expert` 的行上为真）。
      expert_name = "mtp.layers.{i}.{scope}experts.{expert}.{physical}"
      global_name = "{physical}"
      scope { Lin = linear_attn., GQA = self_attn., MTPAttn = self_attn., MoE = mlp., MTPMoe = mlp., Vis = attn., VisMlp = mlp., layer = "", global = "" }
      rename {
        embed.weight      = model.language_model.embed_tokens.weight,
        final_norm.weight = model.language_model.norm.weight,
        mtp_fc.weight             = mtp.fc.weight,
        mtp_norm_embedding.weight = mtp.pre_fc_norm_embedding.weight,
        mtp_norm_hidden.weight    = mtp.pre_fc_norm_hidden.weight,
        mtp_norm.weight           = mtp.norm.weight
      }
    }
  }
}
