# ── laguna-xs-2.1.by1 ───────────────────────────────────────────────
# poolside 的 Laguna XS-2.1。压测：一个**全新实验室**的架构，
# 而且它的每一层都在变——头数、MLP 类型、位置策略。
#
# 事实来源：
#   refs/poolside_Laguna-XS-2_1.config.json   官方 config
#   refs/laguna-xs-2.1.index.json             30513 个权重的名字
#   refs/laguna-xs-2.1.gguf-tensors.json      官方 GGUF 的 678 个张量
#
# 这份文件里标了 ⚠️ 的地方，都是**当前语言说不出来的**。如实留着，不绕。
# by1-model: Laguna-XS-2_1
# by1-repo:  poolside/Laguna-XS-2_1
# by1-short: Laguna-XS-2_1

model Laguna-XS-2_1 {
  arch    laguna
  license apache-2.0
  ctx     262144

  hparams {
    d_model      = 2048
    n_layer      = 40
    vocab        = 100352
    d_ff         = 8192          # 第 0 层的稠密 FFN
    d_ff_moe     = 512           # 每个专家
    d_ff_shared  = 512           # 共享专家
    rms_eps      = 1e-06
  }

  # ── 机制库 ────────────────────────────────────────────────────────
  # 全量层 48 个头、滑窗层 64 个头 —— 头数是**结构属性**。
  # 两者共享同一份 KV 头数（8）和 head_dim（128）。
  mech GQA : Attention {
    heads      = { q = 48, kv = 8, head_dim = 128 }
    qk_norm    = true
    attn_bias  = false
    head_gate  = per_head          # g_proj，形状 (头数, d_model)
    structural = [ q, head_dim, head_gate, out_dim ]
  }

  mech Dense : FFN {
    hidden     = 8192
    layer_kind = dense             # 给 config 的 mlp_layer_types 用
  }

  mech MoE : MoE {
    experts       = 256
    top_k         = 8
    shared        = 1
    hidden        = 512
    shared_hidden = 512
    score_bias    = true           # e_score_correction_bias
    routed_scale  = 2.5            # moe_routed_scaling_factor
    layer_kind    = sparse
    structural    = [ experts, hidden, shared_hidden ]
  }

  # ── 调度：1 全量 + 3 滑窗，十轮 ──────────────────────────────────
  schedule {
    full    = 1 * GQA(window = none, q = 48, out_dim = 6144)
    sliding = 3 * GQA(window = 512,  q = 64, out_dim = 8192)
    block   = full + sliding
  }

  stack main {
    pattern = 10 * block         # 40 层

    # ⚠️ 缺口 1：`>>` 目前只能整栈挂载，说不出「第 0 层挂稠密、其余挂 MoE」。
    #    官方 config 用 mlp_layer_types 数组表达（1 个 dense + 39 个 sparse）。
    main[0]     >> Dense
    main[1..39] >> MoE
  }

  # ── 位置：同一个模型里两套完全不同的 RoPE ────────────────────────
  #   全量层：YaRN，partial 0.5，theta 500000
  #   滑窗层：默认，partial 1.0，theta 10000
  position {
    full    = yarn(rope(base = 500000, pairing = half), factor = 32,
                   original = 8192, beta_fast = 64, beta_slow = 1,
                   partial = 0.5, attention_factor = 1.3465735902799727)
    sliding = rope(base = 10000, pairing = half, partial = 1.0)
  }

  # ── 张量契约 ──────────────────────────────────────────────────────
  # 实测形状（L0 = 全量+稠密，L1 = 滑窗+MoE）：
  #   q_proj [6144,2048] / [8192,2048]      k/v_proj [1024,2048]
  #   o_proj [2048,6144] / [2048,8192]      g_proj [48,2048] / [64,2048]
  #   L0: gate/up [8192,2048] down [2048,8192]
  #   L1: router [256,2048]  shared gate/up [512,2048] down [2048,512]
  tensors {
    GQA {
      q_proj : (q * head_dim, d_model)
      k_proj : (kv * head_dim, d_model)
      v_proj : (kv * head_dim, d_model)
      o_proj : (d_model, q * head_dim)
      g_proj : (q, d_model)
      q_norm : (head_dim,)
      k_norm : (head_dim,)
    }
    Dense {
      gate_proj : (hidden, d_model)
      up_proj   : (hidden, d_model)
      down_proj : (d_model, hidden)
    }
    MoE {
      gate       : (experts, d_model)
      exp_bias   : (experts,)
      shexp_gate : (shared_hidden, d_model)
      shexp_up   : (shared_hidden, d_model)
      shexp_down : (d_model, shared_hidden)
      gate_exps  : (experts, hidden, d_model) per_expert
      up_exps    : (experts, hidden, d_model) per_expert
      down_exps  : (experts, d_model, hidden) per_expert
    }
  }
  # ⚠️ 缺口 2：专家在 HF 侧是**一个专家一个张量**（30513 个权重里 29952 个是它），
  #    名字形如 mlp.experts.{e}.gate_proj.weight —— 名字模板需要一个 {expert} 占位符。
  #    而 GGUF 侧是打包的 ffn_gate_exps.weight [256,512,2048]。
  #    同一件架构事实的第三种分解方式（前两种见 GPT-OSS 的 HF 与 GGUF）。

  # ── 附属 ──────────────────────────────────────────────────────────
  head LmHead { tie_embedding = false }

  # ⚠️ 缺口 3：eos_token_id 是个数组 [2, 24]；层内两个 norm（attn_norm / ffn_norm）
  #    仍然不属于任何机制，写不进 tensors。

  # ── 后端 ──────────────────────────────────────────────────────────
  emit {
    # 产物三：transformers config —— 由 .by1 生成，零继承
    # 官方 config 里那三个逐层数组，都用同一个 per_layer() 生成器算出来。
    train -> transformers.config {
      field {
        model_type              = "laguna"
        vocab_size              = vocab
        hidden_size             = d_model
        intermediate_size       = d_ff
        num_hidden_layers       = n_layer
        max_position_embeddings = ctx
        rms_norm_eps            = rms_eps
        num_attention_heads     = GQA.q
        num_attention_heads_per_layer = per_layer(q)
        num_key_value_heads     = GQA.kv
        head_dim                = GQA.head_dim
        attention_bias          = GQA.attn_bias
        attention_dropout       = 0.0
        num_experts             = MoE.experts
        num_experts_per_tok     = MoE.top_k
        moe_intermediate_size   = MoE.hidden
        shared_expert_intermediate_size = MoE.shared_hidden
        moe_routed_scaling_factor = MoE.routed_scale
        moe_apply_router_weight_on_input = false
        norm_topk_prob          = true
        router_aux_loss_coef    = 0.0
        decoder_sparse_step     = 1
        gating                  = "per-head"
        gating_types            = per_layer(head_gate)
        sliding_window          = GQA[window != none].window
        layer_types             = schedule
        mlp_layer_types         = per_layer(attach.layer_kind)
        mlp_only_layers         = indices_where(attach.layer_kind = dense)
        rope_parameters         = position
        tie_word_embeddings     = LmHead.tie_embedding
        use_cache               = true
        torch_dtype             = "bfloat16"
        bos_token_id            = 2
        eos_token_id            = [2, 24]
        pad_token_id            = 9
      }
    }

    train -> torch.module {
      name        = "model.layers.{i}.{scope}.{physical}"
      expert_name = "model.layers.{i}.mlp.experts.{expert}.{physical}"
      scope { GQA = self_attn, Dense = mlp, MoE = mlp }
      rename {
        q_proj = q_proj.weight, k_proj = k_proj.weight,
        v_proj = v_proj.weight, o_proj = o_proj.weight,
        g_proj = g_proj.weight, q_norm = q_norm.weight, k_norm = k_norm.weight,
        gate_proj = gate_proj.weight, up_proj = up_proj.weight,
        down_proj = down_proj.weight,
        gate = gate.weight,
        exp_bias = experts.e_score_correction_bias,
        shexp_gate = shared_expert.gate_proj.weight,
        shexp_up = shared_expert.up_proj.weight,
        shexp_down = shared_expert.down_proj.weight,
        gate_exps = gate_proj.weight, up_exps = up_proj.weight,
        down_exps = down_proj.weight
      }
    }

    infer -> ggml {
      name  = "blk.{i}.{scope}_{physical}"
      scope { GQA = attn, Dense = ffn, MoE = ffn }
      rename {
        q_proj = q.weight, k_proj = k.weight,
        v_proj = v.weight, o_proj = output.weight,
        g_proj = gate.weight, q_norm = q_norm.weight, k_norm = k_norm.weight,
        gate_proj = gate.weight, up_proj = up.weight, down_proj = down.weight,
        gate = gate_inp.weight,
        exp_bias = exp_probs_b.bias,
        shexp_gate = gate_shexp.weight,
        shexp_up = up_shexp.weight,
        shexp_down = down_shexp.weight,
        gate_exps = gate_exps.weight, up_exps = up_exps.weight,
        down_exps = down_exps.weight
      }
    }
  }
}
