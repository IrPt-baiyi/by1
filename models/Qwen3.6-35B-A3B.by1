# ── qwen36.by1 ────────────────────────────────────────────────────────
# Qwen/Qwen3.6-35B-A3B —— 同一个 Qwen3.5 形状，但把稠密 FFN 换成 MoE。
#
# 这一份的价值在于**它不该有新东西**：线性注意力（GDN）、3+1 混合、
# 输出门控、按头 QK-norm、MoE、共享专家、共享专家门控、MTP ——
# 每一样前面都已经有了。如果它还要新属性，那就是没收敛。
#
# 和 Qwen3.8-27B 的差别只有三处：
#   ① 没有稠密 FFN（config 里 intermediate_size = null）
#   ② 每一层都是 MoE（40/40，不像 Ling/Step 那样第一层是稠密）
#   ③ 专家是**融合存储**的：experts.gate_up_proj 而不是分开的两块
#
# 事实来源：
#   refs/Qwen__Qwen3.6-35B-A3B.config.json
#   refs/qwen36.tensors.json（1045 个张量，26 个分片全读）
# by1-model: Qwen3.6-35B-A3B
# by1-repo:  Qwen/Qwen3.6-35B-A3B
# by1-short: Qwen3.6-35B-A3B

model Qwen3.6-35B-A3B {
  arch  qwen3_5_moe
  ctx   262144

  hparams {
    d_model = 2048
    n_layer = 40
    vocab   = 248320
    rms_eps = 1e-06
  }

  mech Lin : Linear {
    k_heads     = 16
    k_dim       = 128
    v_heads     = 32
    v_dim       = 128
    conv_kernel = 4
    act         = silu
    structural  = [ k_heads, k_dim, v_heads, v_dim, conv_kernel, out_dim ]
  }

  mech GQA : Attention {
    heads      = { q = 16, kv = 2, head_dim = 256 }
    out_dim    = 4096
    q_gate     = true
    qk_norm    = per_head
    structural = [ head_dim, out_dim, q_gate, qk_norm ]
  }

  # ── MoE：融合存储 + 共享专家 + 共享专家门控 ──────────────────────
  # 实测：experts.gate_up_proj [256, 1024, 2048] = (E, 2*512, d)
  #       experts.down_proj    [256, 2048, 512]  = (E, d, 512)
  #       shared_expert_gate   [1, 2048]         —— 给共享专家的输出再乘一个标量
  mech MoE : MoE {
    experts       = 256
    top_k         = 8
    hidden        = 512
    shared        = 1
    shared_hidden = 512
    shared_gate   = true
    routing       = softmax_topk
    layer_kind    = sparse
    structural    = [ experts, hidden, shared_hidden, shared_gate ]
  }

  mech MTPAttn : Attention {
    heads      = { q = 16, kv = 2, head_dim = 256 }
    out_dim    = 4096
    q_gate     = true
    qk_norm    = per_head
    structural = [ head_dim, out_dim, q_gate, qk_norm ]
  }
  mech MTPMoe : MoE {
    experts       = 256
    top_k         = 8
    hidden        = 512
    shared        = 1
    shared_hidden = 512
    shared_gate   = true
    routing       = softmax_topk
    structural    = [ experts, hidden, shared_hidden, shared_gate ]
  }

  # ── 视觉塔（27 层）────────────────────────────────────────────────
  # 和 clef / Qwen3.8-27B 的**逐张量同名同形状**（实测 333 个）。
  # 16 头 x 72 = 1152 ✓，融合 qkv 带 bias，MLP 两层无门控，每层两个 LayerNorm。
  mech Vis : Attention {
    heads      = { q = 16, kv = 16, head_dim = 72 }
    bias       = true
    structural = [ head_dim ]
  }
  mech VisMlp : FFN { hidden = 4304, gate = none, bias = true }

  schedule {
    lin   = 3 * Lin
    full  = 1 * GQA
    block = lin + full
  }

  stack model {
    pattern = 10 * block           # 40 层 = 10 × 4
    model[:] >> MoE
  }

  stack mtp {
    aux     = true
    pattern = 1 * MTPAttn
    mtp[:] >> MTPMoe
  }

  # 视觉塔：27 层，自己的宽度 1152（主干是 5120），`aux = true`。
  # 和 clef / Qwen3.8-27B 的**逐张量同名同形状**（实测 333 个）。
  stack visual {
    d_model = 1152
    aux     = true
    pattern = 27 * Vis
    visual[:] >> VisMlp
  }

  position {
    default = partial(rope(base = 10000000, pairing = half), ratio = 0.25)
  }

  tensors {
    Lin {
      in_proj_qkv.weight : (k_heads * k_dim * 2 + v_heads * v_dim, d_model)
      in_proj_z.weight   : (v_heads * v_dim, d_model)
      in_proj_a.weight   : (v_heads, d_model)
      in_proj_b.weight   : (v_heads, d_model)
      conv1d.weight      : (k_heads * k_dim * 2 + v_heads * v_dim, 1, conv_kernel)
      A_log              : (v_heads,)
      dt_bias            : (v_heads,)
      norm.weight        : (v_dim,)
      out_proj.weight    : (d_model, v_heads * v_dim)
    }
    GQA {
      q_proj.weight : (q * head_dim * 2, d_model)
      k_proj.weight : (kv * head_dim, d_model)
      v_proj.weight : (kv * head_dim, d_model)
      o_proj.weight : (d_model, q * head_dim)
      q_norm.weight : (head_dim,)
      k_norm.weight : (head_dim,)
    }
    MTPAttn {
      q_proj.weight : (q * head_dim * 2, d_model)
      k_proj.weight : (kv * head_dim, d_model)
      v_proj.weight : (kv * head_dim, d_model)
      o_proj.weight : (d_model, q * head_dim)
      q_norm.weight : (head_dim,)
      k_norm.weight : (head_dim,)
    }
    # **专家是融合存储的** —— checkpoint 里就是 `experts.gate_up_proj`，
    # 不是分开的 gate_exps / up_exps。契约照实说。
    MoE {
      gate.weight                       : (experts, d_model)
      experts.gate_up_proj              : (experts, 2 * hidden, d_model)
      experts.down_proj                 : (experts, d_model, hidden)
      shared_expert.gate_proj.weight    : (shared_hidden, d_model)
      shared_expert.up_proj.weight      : (shared_hidden, d_model)
      shared_expert.down_proj.weight    : (d_model, shared_hidden)
      shared_expert_gate.weight         : (1, d_model)
    }
    MTPMoe {
      gate.weight                       : (experts, d_model)
      experts.gate_up_proj              : (experts, 2 * hidden, d_model)
      experts.down_proj                 : (experts, d_model, hidden)
      shared_expert.gate_proj.weight    : (shared_hidden, d_model)
      shared_expert.up_proj.weight      : (shared_hidden, d_model)
      shared_expert.down_proj.weight    : (d_model, shared_hidden)
      shared_expert_gate.weight         : (1, d_model)
    }
    layer {
      input_layernorm.weight          : (d_model,)
      post_attention_layernorm.weight : (d_model,)
    }
    # 视觉块。这一栈里的 `d_model` 是 1152（见 `stack visual`）。
    Vis {
      qkv.weight  : (3 * q * head_dim, d_model)
      qkv.bias    : (3 * q * head_dim,)
      proj.weight : (d_model, q * head_dim)
      proj.bias   : (d_model,)
    }
    VisMlp {
      linear_fc1.weight : (hidden, d_model)
      linear_fc1.bias   : (hidden,)
      linear_fc2.weight : (d_model, hidden)
      linear_fc2.bias   : (d_model,)
    }
    # 视觉塔的层内张量**和主干不是一套** —— 所以是 `layer <栈名>`。
    layer visual {
      norm1.weight : (d_model,)
      norm1.bias   : (d_model,)
      norm2.weight : (d_model,)
      norm2.bias   : (d_model,)
    }
    global {
      embed.weight      : (vocab, d_model)
      final_norm.weight : (d_model,)
      lm_head.weight    : (vocab, d_model)
      mtp_fc.weight             : (d_model, 2 * d_model)
      mtp_norm_embedding.weight : (d_model,)
      mtp_norm_hidden.weight    : (d_model,)
      mtp_norm.weight           : (d_model,)
      # ── 视觉塔里不属于任何层的那 9 个 ──
      # ⚠ **`merger` 那两条和 clef / Qwen3.8 不一样**：merger 的输出宽度是
      # **这个模型自己的 `d_model`**（2048），而视觉塔那 27 层是 1152。
      # 量出来才知道 —— 三份发布的**层内** 333 个逐张量相同 ✓，
      # 而**层外**的 merger 跟着各自的 `d_model` 变 ✗。
      model.visual.patch_embed.proj.weight  : (1152, 3, 2, 16, 16)
      model.visual.patch_embed.proj.bias    : (1152,)
      model.visual.pos_embed.weight         : (2304, 1152)
      model.visual.merger.norm.weight       : (1152,)
      model.visual.merger.norm.bias         : (1152,)
      model.visual.merger.linear_fc1.weight : (4608, 4608)
      model.visual.merger.linear_fc1.bias   : (4608,)
      model.visual.merger.linear_fc2.weight : (d_model, 4608)
      model.visual.merger.linear_fc2.bias   : (d_model,)
    }
  }

  emit {
    train -> transformers.config {
      field {
        model_type                  = "qwen3_5_moe_text"
        vocab_size                  = vocab
        hidden_size                 = d_model
        num_hidden_layers           = n_layer
        num_attention_heads         = GQA.q
        num_key_value_heads         = GQA.kv
        head_dim                    = GQA.head_dim
        max_position_embeddings     = ctx
        rms_norm_eps                = rms_eps
        hidden_act                  = "silu"
        attention_bias              = false
        attention_dropout           = 0.0
        initializer_range           = 0.02
        rope_parameters             = {"rope_theta": 10000000, "rope_type": "default", "partial_rotary_factor": 0.25, "mrope_interleaved": true, "mrope_section": [11, 11, 10]}
        partial_rotary_factor       = 0.25
        use_cache                   = true
        dtype                       = "bfloat16"
        layer_types                 = layer_types
        full_attention_interval     = 4
        attn_output_gate            = true
        linear_conv_kernel_dim      = 4
        linear_key_head_dim         = 128
        linear_num_key_heads        = 16
        linear_num_value_heads      = 32
        linear_value_head_dim       = 128
        mamba_ssm_dtype             = "float32"
        num_experts                 = MoE.experts
        num_experts_per_tok         = MoE.top_k
        moe_intermediate_size       = MoE.hidden
        shared_expert_intermediate_size = MoE.shared_hidden
        router_aux_loss_coef        = 0.001
        output_router_logits        = false
        mtp_num_hidden_layers       = 1
        mtp_use_dedicated_embeddings = false
        tie_word_embeddings         = false
        bos_token_id                = 248044
        eos_token_id                = 248044
        pad_token_id                = null
      }
    }

    train -> torch.module {
      name_model  = "model.language_model.layers.{i}.{scope}{physical}"
      name_mtp    = "mtp.layers.{i}.{scope}{physical}"
      name_visual = "model.visual.blocks.{i}.{scope}{physical}"
      name        = "{stack}.layers.{i}.{scope}{physical}"
      global_name = "{physical}"
      scope { Lin = linear_attn., GQA = self_attn., MTPAttn = self_attn., MoE = mlp., MTPMoe = mlp., Vis = attn., VisMlp = mlp., layer = "", global = "" }
      rename {
        input_layernorm.weight          = input_layernorm.weight,
        post_attention_layernorm.weight = post_attention_layernorm.weight,
        embed.weight      = model.language_model.embed_tokens.weight,
        final_norm.weight = model.language_model.norm.weight,
        mtp_fc.weight             = mtp.fc.weight,
        mtp_norm_embedding.weight = mtp.pre_fc_norm_embedding.weight,
        mtp_norm_hidden.weight    = mtp.pre_fc_norm_hidden.weight,
        mtp_norm.weight           = mtp.norm.weight
      }
    }
  }
}
