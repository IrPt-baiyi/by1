# ── kda-gva-shaped.by1 ────────────────────────────────────────────────
# KDA 的 **GVA 变体**：q/k 的头数**少于** v 的头数。
#
# 和 `kda-shaped.by1` 只差一行（`k_heads = 2`），而那一行值得单独一份：
#
#   `fla/ops/kda/naive.py:52-53` 里是
#       q = q.repeat_interleave(G, dim=2)
#       k = k.repeat_interleave(G, dim=2)      # G = HV // H
#   而 by1 的两个后端**原来都没有这一句** —— 于是这个组合一跑就
#       RuntimeError: The size of tensor a (2) must match b (4)
#   而契约和 `by1ir.ATTRS["KDA"]` **都允许** `k_heads ≠ v_heads`
#   （它们是两个独立属性）—— 也就是**"声明了、但一跑就炸"**。
#
# 而判卷人 `src/modelcheck/by1kda.py` 判的是 **PyTorch 那一个后端**
# （它拿 IR 生成运行时，再自己喂尺寸）。NumPy 那一侧的分支
# 只有这份文件能长期管住 —— 所以它必须是一个**留在仓库里的模型**，
# 而不是一次性的临时文件。
#
#   python by1exec.py kda-gva-shaped.by1 --compare     NumPy vs PyTorch
#
# 判卷人是谁：`by1kda.py` 的 "GVA" 那个正例（对着 fla 的
# `naive_recurrent_kda`）+ 这份文件的 `--compare`（两个后端互相对）。

model KDA-GVA-shaped {
  arch  kda_gva_shaped
  ctx   1024

  hparams {
    d_model = 128
    n_layer = 4
    vocab   = 512
    rms_eps = 1e-05
  }

  # Kimi Delta Attention，GVA 那一支。
  #   kd = k_heads * k_dim = 2 * 16 = 32
  #   vd = v_heads * v_dim = 4 * 16 = 64
  #   gate_dim = v_heads * k_dim = 64      <- dt_bias 和门的宽度都是它
  # 注意 `gate_dim` 跟的是 **v_heads**，不是 k_heads —— 这是 KDA 的定义，
  # 而它正是最容易按对称性写反的地方。
  mech KDA_ : KDA {
    k_heads     = 2
    v_heads     = 4
    k_dim       = 16
    v_dim       = 16
    conv_kernel = 4
    conv_bias   = false
    gate_lowrank = false
    act         = silu
    structural  = [ k_heads, v_heads, k_dim, v_dim, conv_kernel ]
  }

  mech MLP_ : FFN { hidden = 256 }

  stack main {
    pattern = 4 * KDA_
    main[:] >> MLP_
  }

  position {
    default = none
  }

  tensors {
    KDA_ {
      q_proj.weight   : (k_heads * k_dim, d_model)
      k_proj.weight   : (k_heads * k_dim, d_model)
      v_proj.weight   : (v_heads * v_dim, d_model)
      q_conv1d.weight : (k_heads * k_dim, 1, conv_kernel)
      k_conv1d.weight : (k_heads * k_dim, 1, conv_kernel)
      v_conv1d.weight : (v_heads * v_dim, 1, conv_kernel)
      A_log           : (v_heads,)
      dt_bias         : (v_heads * k_dim,)
      b_proj.weight   : (v_heads, d_model)
      f_proj.weight   : (v_heads * k_dim, d_model)
      g_proj.weight   : (v_heads * v_dim, d_model)
      o_norm.weight   : (v_dim,)
      o_proj.weight   : (d_model, v_heads * v_dim)
    }
    MLP_ {
      gate_proj.weight : (hidden, d_model)
      up_proj.weight   : (hidden, d_model)
      down_proj.weight : (d_model, hidden)
    }
    layer {
      attn_norm.weight : (d_model,)
      mlp_norm.weight  : (d_model,)
    }
    global {
      embed.weight      : (vocab, d_model)
      final_norm.weight : (d_model,)
      lm_head.weight    : (vocab, d_model)
    }
  }

  emit {
    train -> torch.module {
      name        = "model.layers.{i}.{scope}{physical}"
      global_name = "{physical}"
      scope { KDA_ = mixer., MLP_ = mlp., layer = "", global = "" }
      rename {
        attn_norm.weight  = input_layernorm.weight,
        mlp_norm.weight   = post_attention_layernorm.weight,
        embed.weight      = model.embed_tokens.weight,
        final_norm.weight = model.norm.weight
      }
    }
  }
}
