# ── qwen38.by1 ────────────────────────────────────────────────────────
# Qwen/Qwen3.8-27B —— clef **加上 MTP**。
#
# 实测它和 Cloudflare/clef 的关系是精确的：
#   1184 / 1199 个张量同名同形，多出来的 15 个**全部**是 `mtp.*`
#   而 config 里 mtp_num_hidden_layers = 1（clef 是 0）
#
# **所以 MTP 是这一族里唯一的新东西。** 其余整套（48 层线性注意力、
# 16 层全量、输出门控、按头 QK-norm）在 Qwen3-Next 时代就有了。
#
# MTP（多 token 预测）不是推理路径的一部分 —— 它是训练时的辅助头，
# 推理时用于投机解码。但它**在权重文件里**，所以描述要能表达它。
# 而它和主干是**并列的两个栈**，不是串行：它同时吃 embedding 和 hidden。
#
# 事实来源：
#   refs/Qwen__Qwen3.8-27B.config.json
#   refs/qwen38.tensors.json（1199 个张量，18 个分片全读）
# by1-model: Qwen3.8-27B
# by1-repo:  Qwen/Qwen3.8-27B
# by1-short: Qwen3.8-27B

model Qwen3.8-27B {
  arch  qwen3_5
  ctx   262144

  hparams {
    d_model = 5120
    n_layer = 64
    vocab   = 248320
    rms_eps = 1e-06
  }

  # ── 线性注意力（48 层）────────────────────────────────────────────
  mech Lin : Linear {
    k_heads     = 16
    k_dim       = 128
    v_heads     = 48
    v_dim       = 128
    conv_kernel = 4
    act         = silu
    structural  = [ k_heads, k_dim, v_heads, v_dim, conv_kernel, out_dim ]
  }

  # ── 全量注意力（16 层，每四层一次）───────────────────────────────
  mech GQA : Attention {
    heads      = { q = 24, kv = 4, head_dim = 256 }
    out_dim    = 6144
    q_gate     = true
    qk_norm    = per_head
    structural = [ head_dim, out_dim, q_gate, qk_norm ]
  }

  mech FFN_ : FFN { hidden = 17408 }

  # ── MTP 的那一层：一个标准的全量注意力层（实测 L0 的六件套齐全）──
  mech MTPAttn : Attention {
    heads      = { q = 24, kv = 4, head_dim = 256 }
    out_dim    = 6144
    q_gate     = true
    qk_norm    = per_head
    structural = [ head_dim, out_dim, q_gate, qk_norm ]
  }
  mech MTPFfn : FFN { hidden = 17408 }

  schedule {
    lin   = 3 * Lin
    full  = 1 * GQA
    block = lin + full
  }

  # 主干：64 层 = 16 × 4
  stack model {
    pattern = 16 * block
    model[:] >> FFN_
  }

  # MTP：一个栈，一层。**它不走主干那套命名** ——
  # checkpoint 里是 `mtp.layers.0.…`，没有 language_model 那一段。
  # `aux = true` 是显式声明"这不是解码层"：`n_layer` 和 `layer_types`
  # 都只算主栈，辅助栈不在里面。
  stack mtp {
    aux     = true
    pattern = 1 * MTPAttn
    mtp[:] >> MTPFfn
  }

  position {
    default = partial(rope(base = 10000000, pairing = half), ratio = 0.25)
  }

  tensors {
    Lin {
      in_proj_qkv.weight : (k_heads * k_dim * 2 + v_heads * v_dim, d_model)
      in_proj_z.weight   : (v_heads * v_dim, d_model)
      in_proj_a.weight   : (v_heads, d_model)
      in_proj_b.weight   : (v_heads, d_model)
      conv1d.weight      : (k_heads * k_dim * 2 + v_heads * v_dim, 1, conv_kernel)
      A_log              : (v_heads,)
      dt_bias            : (v_heads,)
      norm.weight        : (v_dim,)
      out_proj.weight    : (d_model, v_heads * v_dim)
    }
    GQA {
      q_proj.weight : (q * head_dim * 2, d_model)
      k_proj.weight : (kv * head_dim, d_model)
      v_proj.weight : (kv * head_dim, d_model)
      o_proj.weight : (d_model, q * head_dim)
      q_norm.weight : (head_dim,)
      k_norm.weight : (head_dim,)
    }
    MTPAttn {
      q_proj.weight : (q * head_dim * 2, d_model)
      k_proj.weight : (kv * head_dim, d_model)
      v_proj.weight : (kv * head_dim, d_model)
      o_proj.weight : (d_model, q * head_dim)
      q_norm.weight : (head_dim,)
      k_norm.weight : (head_dim,)
    }
    FFN_ {
      gate_proj.weight : (hidden, d_model)
      up_proj.weight   : (hidden, d_model)
      down_proj.weight : (d_model, hidden)
    }
    MTPFfn {
      gate_proj.weight : (hidden, d_model)
      up_proj.weight   : (hidden, d_model)
      down_proj.weight : (d_model, hidden)
    }
    layer {
      input_layernorm.weight          : (d_model,)
      post_attention_layernorm.weight : (d_model,)
    }
    global {
      embed.weight      : (vocab, d_model)
      final_norm.weight : (d_model,)
      lm_head.weight    : (vocab, d_model)
      # ── MTP 自己的全局张量 ──────────────────────────────────────
      # mtp.fc 实测 [5120, 10240] = (d, 2d) —— 把 norm 过的 embedding
      # 和 norm 过的 hidden 拼起来再降回去
      mtp_fc.weight            : (d_model, 2 * d_model)
      mtp_norm_embedding.weight : (d_model,)
      mtp_norm_hidden.weight    : (d_model,)
      mtp_norm.weight           : (d_model,)
    }
  }

  emit {
    train -> transformers.config {
      field {
        model_type                  = "qwen3_5_text"
        vocab_size                  = vocab
        hidden_size                 = d_model
        num_hidden_layers           = n_layer
        intermediate_size           = FFN_.hidden
        num_attention_heads         = GQA.q
        num_key_value_heads         = GQA.kv
        head_dim                    = GQA.head_dim
        max_position_embeddings     = ctx
        rms_norm_eps                = rms_eps
        hidden_act                  = "silu"
        attention_bias              = false
        attention_dropout           = 0.0
        initializer_range           = 0.02
        rope_parameters             = {"rope_theta": 10000000, "rope_type": "default", "partial_rotary_factor": 0.25, "mrope_interleaved": true, "mrope_section": [11, 11, 10]}
        partial_rotary_factor       = 0.25
        use_cache                   = true
        dtype                       = "bfloat16"
        layer_types                 = layer_types
        full_attention_interval     = 4
        attn_output_gate            = true
        output_gate_type            = "swish"
        linear_conv_kernel_dim      = 4
        linear_key_head_dim         = 128
        linear_num_key_heads        = 16
        linear_num_value_heads      = 48
        linear_value_head_dim       = 128
        mamba_ssm_dtype             = "float32"
        mtp_num_hidden_layers       = 1
        mtp_use_dedicated_embeddings = false
        tie_word_embeddings         = false
        bos_token_id                = 248044
        eos_token_id                = 248044
        pad_token_id                = null
      }
    }

    train -> torch.module {
      # **两个栈两套前缀。** 主干带 language_model 那一段，MTP 不带。
      name_model  = "model.language_model.layers.{i}.{scope}{physical}"
      name_mtp    = "mtp.layers.{i}.{scope}{physical}"
      name        = "{stack}.layers.{i}.{scope}{physical}"
      global_name = "{physical}"
      # **scope 必须写在一行里** —— 换行会让解析器只读到第一段，
      # 于是 scope 变成空的、所有前缀静默消失（表现是"名字全对不上"）。
      scope { Lin = linear_attn., GQA = self_attn., MTPAttn = self_attn., FFN_ = mlp., MTPFfn = mlp., layer = "", global = "" }
      rename {
        input_layernorm.weight          = input_layernorm.weight,
        post_attention_layernorm.weight = post_attention_layernorm.weight,
        embed.weight      = model.language_model.embed_tokens.weight,
        final_norm.weight = model.language_model.norm.weight,
        mtp_fc.weight             = mtp.fc.weight,
        mtp_norm_embedding.weight = mtp.pre_fc_norm_embedding.weight,
        mtp_norm_hidden.weight    = mtp.pre_fc_norm_hidden.weight,
        mtp_norm.weight           = mtp.norm.weight
      }
    }
  }
}
