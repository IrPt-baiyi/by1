# ── glm53.by1 ─────────────────────────────────────────────────────────
# zai-org/GLM-5.3-Flash —— 这批里**最富**的一个，也是唯一同时用上
# 1.md 里点名的那两样的：稀疏索引器 + mHC 残差。
#
# 它的形状是 3+1 混合，和 Ling / Qwen3.5 同族，但每一块都往上加了一层：
#
#   线性注意力    KDA（Ling 那个，不是 GDN）    3 层一组
#   全量注意力    **MLA + 稀疏索引器**          1 层
#   残差          **mHC**（hc_mult = 4）        每层
#   专家          288 选 8，noaux_tc            前 3 层稠密
#   MTP           1 层
#
# 事实来源：
#   refs/zai-org__GLM-5.3-Flash.config.json 的 text_config
#   refs/zai-org__GLM-5.3-Flash.tensors.json（76108 个张量，62 个分片）
# by1-model: GLM-5.3-Flash
# by1-repo:  zai-org/GLM-5.3-Flash
# by1-short: GLM-5.3-Flash

model GLM-5.3-Flash {
  arch  glm5_next
  ctx   1048576

  hparams {
    d_model = 4096
    n_layer = 45
    vocab   = 154880
    rms_eps = 1e-05
  }

  # ── 线性注意力：KDA ───────────────────────────────────────────────
  # 名字和 Ling 的一样（kda_layers），但它在这里是 34 层
  mech KDA : KDA {
    num_heads     = 64
    head_dim      = 128
    conv_kernel   = 4
    gate_lower    = -5.0
    gate_lowrank  = true
    gate_rank     = 128
    # **官方权重清单里没有 `g_b_proj.bias`** —— 而 fla 的层写的是
    # `bias=True`。两个出处不一致，所以这里必须显式关掉：
    # 76108 个张量里 `.bias` 只有 135 个，全是 indexer 和视觉塔的。
    gate_out_bias = false
    structural    = [ num_heads, head_dim, conv_kernel ]
  }

  # ── 全量注意力：MLA **加一个稀疏索引器** ──────────────────────────
  # q_lora 1536 / kv_lora 512 / qk_nope 256 / qk_rope **0** / v 256
  # qk_rope_head_dim = 0 且 mla_use_nope = true —— **它没有 RoPE**
  # 索引器：32 个头、头维 128、每层挑 2048 个 key
  mech SparseMLA : MLA {
    q          = 64
    v_dim      = 256
    qk_nope    = 256
    qk_rope    = 0
    q_lora     = 1536
    kv_lora    = 512
    index_heads = 32
    index_dim   = 128
    index_topk  = 2048
    # 这个 config 对这一层有自己的叫法 —— 因为它带稀疏索引器
    ltype       = deepseek_sparse_attention
    structural = [ q, v_dim, qk_nope, qk_rope, q_lora, kv_lora ]
  }

  mech MoE : MoE {
    experts       = 288
    hidden        = 2048          # moe_intermediate_size
    top_k         = 8
    shared        = 1
    routed_scale  = 2.5
    n_group       = 1
    topk_group    = 1
    # **这里原来写的是 `routing = softmax_topk` 加一个 `scoring = sigmoid` ✗。**
    # 那是**错的**，而且是那种"契约全对、config 全对、生成出来是另一个模型"
    # 的错 —— 因为 `scoring` **没有任何人读它**（grep 全库只有注释提到），
    # 于是前向走的是 softmax 打分，而官方是 **sigmoid 打分 + noaux_tc 分组**。
    #
    # 判据是官方实现（transformers 的 `GlmMoeDsaTopkRouter`）：
    #     scores = router_logits.sigmoid()
    #     scores_for_choice = scores + e_score_correction_bias
    #     按组取前 2 求和 -> 选 topk_group 个组 -> 组内选 top_k
    #     norm_topk_prob -> * routed_scaling_factor
    # 这逐行就是本库里 `routing = sigmoid_group_topk` 那一支（和 Ling 同一个）。
    # config 也对得上：`scoring_func = "sigmoid"` · `topk_method = "noaux_tc"`。
    #
    # **`scoring` 这个属性不加** —— 它和 `routing` 说的是同一件事，
    # 两个地方说同一件事就一定会不一致（这次就是）。
    routing       = sigmoid_group_topk
    swiglu_limit  = 10.0
    layer_kind    = sparse
    structural    = [ experts, hidden, shared, n_group, topk_group ]
  }

  mech Dense : FFN { hidden = 12288 }

  # ── 视觉塔（24 层）────────────────────────────────────────────────
  # **只描述，不算前向** —— 这一批视觉张量的现状是"描述得住、算不了"。
  # 官方 `vision_config`：hidden_size 1024 · depth 24 · num_heads 16 ·
  # intermediate_size 4096 · out_hidden_size 4096 ·
  # projection_intermediate_size 10240 · attention_bias true ·
  # spatial_merge_size 2 · temporal_patch_size 2 · patch_size 14。
  # 和文本主干**不是一套**：融合 qkv、带 bias、MLP 三线性（gate/up/down）
  # 也带 bias、每层两个 norm **不带** bias、宽度 1024（主干 4096）。
  # 16 头 x 64 = 1024 ✓（`q_norm` / `k_norm` 实测 [64] ✓）。
  mech Vis : Attention {
    heads      = { q = 16, kv = 16, head_dim = 64 }
    bias       = true
    structural = [ head_dim ]
  }
  mech VisMlp : FFN {
    hidden = 4096
    bias   = true
  }

  schedule {
    kda   = 3 * KDA
    full  = 1 * SparseMLA
    block = kda + full
  }

  stack model {
    # **尾巴是线性的，不是全量的。** config 的 full_attn_layers 是
    # [3,7,11,...,43]，所以 L44 落在 3+1 之外 —— 它还是一个 KDA 层。
    # 我第一版写成 `+ 1 * full`，就是那一层对不上。
    pattern       = 11 * block + 1 * KDA
    model[0..2]   >> Dense
    model[3..44]  >> MoE
  }

  # ── MTP（1 层）───────────────────────────────────────────────────
  # `num_nextn_predict_layers = 1`。它**在权重文件里**，所以描述要能表达它。
  # 官方那层就在 `model.language_model.layers.45.` 下面 —— 和主干同一个前缀、
  # **层号接着数**，所以是 `index = global`（不是各栈从 0 起）。
  # 这一层是 SparseMLA + MoE，另外多 4 个 MTP 专属张量（见 `layer mtp`）。
  #
  # ⚠ **顺序要紧**：`index = global` 取的是"所有栈合起来的序号"，
  #   所以 mtp 必须紧跟在主干后面（45 层之后正好是 45）。
  stack mtp {
    aux     = true
    index   = global
    pattern = 1 * SparseMLA
    mtp[:]  >> MoE
  }

  # 视觉塔：24 层，自己的宽度 1024（主干 4096），`aux = true`。
  stack visual {
    d_model = 1024
    aux     = true
    pattern = 24 * Vis
    visual[:] >> VisMlp
  }

  position {
    # qk_rope_head_dim = 0 —— 全量那 11 层**不用位置编码**。
    # 但 config 里仍有 max_position_embeddings，那是给别的部件留的。
    default = rope(base = 10000, pairing = half)
  }

  tensors {
    # ⚠ **这里原来有第二个 `KDA { }` 块** —— 10 行、不完整，
    # 而它在第 159 行那个完整块**之前**，于是被静默覆盖 ✓。
    #
    # 后果：谁往那个块里加东西，**等于没加** ✓。我上一轮就往里加了 5 行
    # （`b_proj` / `f_a/f_b` / `g_a/g_b`），跑了三遍 `by1verify` 数都没动 ✓，
    # 于是得出了"检查漏验了这 510 个张量"的错误结论 ✗。
    #
    # 真因是：**同一个 `tensors` 里两个同名契约块，后来的直接覆盖先前的，
    # 一声不响**（`by1tens.py:166` 的 `_['contracts'][base] = _['lst']`）。
    #
    # 删掉它 ✓ —— 而真正的 KDA 契约是下面第 159 行那个（现在 15 行 ✓）。
    #
    # **要防的是下一个**：`by1lint` 该加一条"同名契约块出现两次就报" ✓，
    # 否则这个坑会再埋一次 ✓。

    # ── 全量层：MLA **加一个稀疏索引器** ──────────────────────────
    # 索引器是**独立的一套投影**：它自己从 q_lora 出发（wq_b [4096,1536]
    # = 32 头 × 128），自己算 key（wk [128,4096]），再用 weights_proj
    # [32,4096] 给每个头打分。所以它比 MLA 多 7 个张量。
    SparseMLA {
      q_a_proj.weight            : (1536, d_model)
      q_a_layernorm.weight       : (1536,)
      q_b_proj.weight            : (16384, 1536)
      kv_a_proj_with_mqa.weight  : (512, d_model)
      kv_a_layernorm.weight      : (512,)
      kv_b_proj.weight           : (32768, 512)
      o_proj.weight              : (d_model, 16384)
      indexer.wq_b.weight            : (4096, 1536)
      indexer.wk.weight              : (128, d_model)
      indexer.weights_proj.weight    : (32, d_model)
      indexer.k_norm.weight          : (128,)
      indexer.k_norm.bias            : (128,)
      indexer.index_kpool_compress_gate : (128, d_model)
      indexer.index_kpool_compress_ape  : (4, 128)
    }
    # ── 线性层：KDA，但门是**低秩**的 ─────────────────────────────
    # 和 Ling 的 KDA 不一样：那边 f 是一个矩阵，这边是 f_a/f_b 两级
    # （128 的瓶颈），g 也一样。
    KDA {
      q_proj.weight    : (8192, d_model)
      k_proj.weight    : (8192, d_model)
      v_proj.weight    : (8192, d_model)
      q_conv1d.weight  : (8192, 1, 4)
      k_conv1d.weight  : (8192, 1, 4)
      v_conv1d.weight  : (8192, 1, 4)
      f_a_proj.weight  : (128, d_model)
      f_b_proj.weight  : (8192, 128)
      g_a_proj.weight  : (128, d_model)
      g_b_proj.weight  : (8192, 128)
      b_proj.weight    : (64, d_model)
      A_log            : (64,)
      dt_bias          : (8192,)
      o_norm.weight    : (128,)
      o_proj.weight    : (d_model, 8192)
    }
    MoE {
      gate.weight                   : (experts, d_model)
      gate.e_score_correction_bias  : (experts,)
      gate_proj.weight              : (experts, hidden, d_model) per_expert
      up_proj.weight                : (experts, hidden, d_model) per_expert
      down_proj.weight              : (experts, d_model, hidden) per_expert
      shared_experts.gate_proj.weight : (hidden, d_model)
      shared_experts.up_proj.weight   : (hidden, d_model)
      shared_experts.down_proj.weight : (d_model, hidden)
    }
    Dense {
      gate_proj.weight : (12288, d_model)
      up_proj.weight   : (12288, d_model)
      down_proj.weight : (d_model, 12288)
    }
    # ── 视觉块。`d_model` 在这个栈里是 1024（见 `stack visual`）。──
    Vis {
      qkv.weight    : (3 * q * head_dim, d_model)
      qkv.bias      : (3 * q * head_dim,)
      q_norm.weight : (head_dim,)
      k_norm.weight : (head_dim,)
      proj.weight   : (d_model, q * head_dim)
      proj.bias     : (d_model,)
    }
    VisMlp {
      gate_proj.weight : (hidden, d_model)
      gate_proj.bias   : (hidden,)
      up_proj.weight   : (hidden, d_model)
      up_proj.bias     : (hidden,)
      down_proj.weight : (d_model, hidden)
      down_proj.bias   : (d_model,)
    }
    layer {
      input_layernorm.weight          : (d_model,)
      post_attention_layernorm.weight : (d_model,)
      # ── mHC：超连接 ──────────────────────────────────────────────
      # hc_mult = 4，所以残差流是 4 宽的；fn 是 [24, 16384] = [4*3*2, 4096*4]
      hc_attn_base  : (24,)
      hc_attn_fn    : (24, 16384)
      hc_attn_scale : (3,)
      hc_ffn_base   : (24,)
      hc_ffn_fn     : (24, 16384)
      hc_ffn_scale  : (3,)
    }
    # ── MTP 那一层的层内张量（第 45 层）──────────────────────────────
    # `layer <栈名>` 是**整块替换**、不是追加（by1tens：取到按栈的就用它），
    # 所以主干那两个 norm 得在这里再写一遍。多出来的 4 个是 MTP 专属的：
    # enorm / hnorm / eh_proj / shared_head.norm。
    # **这一层实测没有 mHC** —— `hc_*` 在未覆盖清单里一个都没有。
    layer mtp {
      input_layernorm.weight          : (d_model,)
      post_attention_layernorm.weight : (d_model,)
      enorm.weight          : (d_model,)
      hnorm.weight          : (d_model,)
      eh_proj.weight        : (d_model, 2 * d_model)
      shared_head.norm.weight : (d_model,)
    }
    # 视觉塔的层内张量**和主干不是一套**：两个 norm，都不带 bias。
    layer visual {
      norm1.weight : (d_model,)
      norm2.weight : (d_model,)
    }
    global {
      embed.weight      : (vocab, d_model)
      final_norm.weight : (d_model,)
      lm_head.weight    : (vocab, d_model)
      # ── 视觉塔里不属于任何层的那 11 个 ──────────────────────────
      # 逻辑名直接写官方全名；`global_name = "{physical}"` 于是原样渲染。
      # 形状逐个对着产物量过（vision_config 里的数字是它们的出处）。
      model.visual.patch_embed.proj.weight  : (1024, 3, 2, 14, 14)
      model.visual.patch_embed.proj.bias    : (1024,)
      model.visual.post_layernorm.weight    : (1024,)
      model.visual.downsample.weight        : (4096, 1024, 2, 2)
      model.visual.downsample.bias          : (4096,)
      model.visual.merger.gate_proj.weight  : (10240, 4096)
      model.visual.merger.up_proj.weight    : (10240, 4096)
      model.visual.merger.down_proj.weight  : (4096, 10240)
      model.visual.merger.proj.weight       : (4096, 4096)
      model.visual.merger.post_projection_norm.weight : (4096,)
      model.visual.merger.post_projection_norm.bias   : (4096,)
    }
  }

  emit {
    train -> transformers.config {
      field {
        model_type                  = "glm5_next_text"
        vocab_size                  = vocab
        hidden_size                 = d_model
        num_hidden_layers           = n_layer
        intermediate_size           = 12288
        moe_intermediate_size       = 2048
        num_attention_heads         = 64
        num_key_value_heads         = 64
        q_lora_rank                 = 1536
        kv_lora_rank                = 512
        qk_nope_head_dim            = 256
        qk_rope_head_dim            = 0
        v_head_dim                  = 256
        mla_use_nope                = true
        max_position_embeddings     = ctx
        rms_norm_eps                = rms_eps
        hidden_act                  = "silu"
        attention_bias              = false
        attention_dropout           = 0.0
        initializer_range           = 0.02
        dtype                       = "bfloat16"
        use_cache                   = true
        tie_word_embeddings         = false
        n_routed_experts            = 288
        n_shared_experts            = 1
        num_experts_per_tok         = 8
        n_group                     = 1
        topk_group                  = 1
        topk_method                 = "noaux_tc"
        scoring_func                = "sigmoid"
        routed_scaling_factor       = 2.5
        norm_topk_prob              = true
        router_aux_loss_coef        = 0.001
        moe_router_dtype            = "float32"
        output_router_logits        = false
        first_k_dense_replace       = 3
        swiglu_limit                = 10.0
        num_nextn_predict_layers    = 1
        # ── 稀疏索引器 ────────────────────────────────────────────
        index_n_heads               = 32
        index_head_dim              = 128
        index_topk                  = 2048
        index_kpool                 = 4
        index_kpool_compress        = true
        index_kpool_always_select_tail = true
        index_share_for_mtp_iteration  = true
        indexer_rope_interleave     = true
        # ── mHC 残差 ──────────────────────────────────────────────
        mhc                         = true
        hc_mult                     = 4
        hc_eps                      = 1e-06
        hc_sinkhorn_iters           = 20
        # ── 别的 ──────────────────────────────────────────────────
        linear_attn_config          = {"num_heads": 64, "head_dim": 128, "short_conv_kernel_size": 4, "gate_lower_bound": -5.0, "kda_layers": [0, 1, 2, 4, 5, 6, 8, 9, 10, 12, 13, 14, 16, 17, 18, 20, 21, 22, 24, 25, 26, 28, 29, 30, 32, 33, 34, 36, 37, 38, 40, 41, 42, 44], "full_attn_layers": [3, 7, 11, 15, 19, 23, 27, 31, 35, 39, 43]}
        layer_types                 = layer_types
        mlp_layer_types             = mlp_layer_types
        indexer_types               = indexer_types
        head_dim                    = 0
        qk_head_dim                 = 256
        eos_token_id                = [154820, 154827, 154829]
        pad_token_id                = 154820
      }
    }

    train -> torch.module {
      # **少了 `language_model.` 这一节，整份契约就等于没验。**
      #
      # 原来的模板是 `model.layers.{i}.…`，而这个 checkpoint 的张量
      # 全在 `model.language_model.layers.{i}.…` 里。而专家张量走的是
      # 另一条模板（`expert_name`），**那条是对的** —— 于是
      # 288 专家 × 42 层 = 36288 个张量全部命中，报告写着
      # "名字+形状一致 36289（97%）"，看起来只差 3%。
      #
      # 实际差的是**别的全部**：注意力、卷积、mHC、norm、稠密 FFN、
      # 共享专家、全局张量 —— 1245 个，一个都没验。
      # **百分比是张量个数，不是覆盖率。**
      name        = "model.language_model.layers.{i}.{scope}{physical}"
      # **视觉塔的物理前缀和主干不同** —— 它在 `model.visual.blocks.` 下面。
      # 主干和 MTP 共用 `name`（同一个前缀，MTP 的层号接着数，见 `index`）。
      # 优先级是 `expert_name > name_<栈名> > name`（见 by1check.render_name）。
      name_visual = "model.visual.blocks.{i}.{scope}{physical}"
      global_name = "{physical}"
      # ⚠ **`scope` 那一行不能折行** —— 花括号不参与续行判定
      #   （`by1check._cont_depth`），折行之后整张映射表**空着**，
      #   渲染出来的名字静默丢掉前缀（报出来是"NNNN 个张量实际不存在"，
      #   看起来像契约写错了）。**现在 by1check 会直接报错** ✓。
      scope { KDA = self_attn., SparseMLA = self_attn., MoE = mlp., Dense = mlp., Vis = attn., VisMlp = mlp., layer = "", global = "" }
      expert_name = "model.language_model.layers.{i}.mlp.experts.{expert}.{physical}"
      rename {
        # 官方这两个不叫 `embed.weight` / `final_norm.weight`：
        embed.weight      = model.language_model.embed_tokens.weight,
        final_norm.weight = model.language_model.norm.weight
        # `lm_head.weight` 不在 rename 里 —— 官方就叫这个名字。
      }
      # ── 导出布局：FP8 块量化（**不是架构！**）───────────────────────
      # 这个 checkpoint 的一部分权重是 FP8 (e4m3) 存的，每 128x128 一块伴
      # 一份 `weight_scale_inv`。**权重本身留着** —— 所以它和 gpt-oss 的
      # MXFP4（权重根本不存在、换成 `_blocks`/`_scales`）是两种布局，
      # `scale` 就是那个分水岭。块大小实测 128x128，所有维度整除。
      # 换一份 BF16 发布就没有这些张量 —— 所以它在 emit 里，不在契约里。
      #
      # **谁被量化了是逐个量出来的，不是按"2-D 权重"推的。** 76108 个张量里
      # 带 `weight_scale_inv` 的只有下面这 10 个逻辑名（13 个等价类）：
      #   · MoE 的 gate/up/down（逐专家）+ 三个共享专家投影
      #   · SparseMLA 的 q_a_proj / q_b_proj / kv_a_proj_with_mqa / o_proj
      #   · Dense 的 gate/up/down
      # **没有**（量过，别顺手加上）：KDA 的全部 9 个投影 · SparseMLA 的
      # `kv_b_proj` 和整个 indexer · 路由器 `gate` · 视觉塔 · embed / lm_head。
      #
      # ⚠ `SparseMLA.o_proj.weight` **必须带机制前缀** —— KDA 也有一个
      # `o_proj.weight`，而它没有被量化。写裸的 `o_proj` 会给 KDA 也发一份，
      # 那会当场报「契约声明了、实际不存在」。
      quant {
        scale  = weight_scale_inv
        block  = 128
        tensor = [SparseMLA.q_a_proj.weight, SparseMLA.q_b_proj.weight,
                  SparseMLA.kv_a_proj_with_mqa.weight, SparseMLA.o_proj.weight,
                  MoE.gate_proj.weight, MoE.up_proj.weight, MoE.down_proj.weight,
                  MoE.shared_experts.gate_proj.weight,
                  MoE.shared_experts.up_proj.weight,
                  MoE.shared_experts.down_proj.weight,
                  Dense.gate_proj.weight, Dense.up_proj.weight,
                  Dense.down_proj.weight]
      }
    }
  }
}
