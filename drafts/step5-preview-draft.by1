      self_attn.sparse_indexer_k_norm.bias :   (256)
      self_attn.sparse_indexer_k_norm.weight : (256)
      self_attn.sparse_indexer_q.weight :      (4096, 4096)
      self_attn.sparse_indexer_q_norm.weight : (256)
      self_attn.sparse_indexer_w.weight :      (16, 4096)
      self_attn.sparse_indexer_z.weight :      (256, 4096)
      self_attn.ssmax_s :                      (64)
      self_attn.v_proj.weight :                (768, 4096)
    }
