# ── 由 by1boot 从产物反推的草稿 ──────────────────────────────
#
# **它不是"帮你写"，是"让你改到验过为止"**：
#     python by1verify.py <这个文件> stepfun-ai__Step-5-Preview-BF16.config.json --config --tensors stepfun-ai__Step-5-Preview-BF16.tensors.json --backend torch.module
#
# 反推不出来的地方，下面都标了 `# ?`。改到 by1verify 全绿为止。
# ──────────────────────────────────────────────────────────

model Step-5-Preview-BF16 {
  arch  step5
  ctx   1048576

  hparams {
    d_model = 4096
    n_layer = 92
    vocab   = 128896
    rms_eps = 1e-05
  }

  # 反推结果：
  #   层数 95，机制分布 {'Attention': 95}
  #   挂在层上的 {'FFN': 7, 'MoE': 88}
  #   全局张量 12 个：lm_head.weight, model.embed_tokens.weight, model.norm.weight, vision_model.conv1.weight, vision_model.ln_pre.bias, vision_model.ln_pre.weight
  #
  # ? 反推不出来的：路由方式 / 有没有共享专家 / 门控激活 /
  #   per_expert 还是打包 / bias / rope 的缩放类型 —— 这些**config 里没有**，
  #   而产物只有名字和形状。改到 by1verify 全绿为止。

  # ── 契约（从 safetensors 头里读的，形状是字面值）──────────
  # 把 (4096, 2688) 换成 (q * head_dim, d_model) 这类符号，
  # 就是"我理解了这个模型" —— 而 by1check 会告诉你换得对不对。

    Attention {
      self_attn.g_proj.weight :                (64, 4096)
      self_attn.k_norm.weight :                (192)
      self_attn.k_proj.weight :                (768, 4096)
      self_attn.o_proj.weight :                (4096, 12288)
      self_attn.q_norm.weight :                (192)
      self_attn.q_proj.weight :                (12288, 4096)
