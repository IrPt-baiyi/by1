# 编译产物
__pycache__/
*.pyc

# 临时探针（用完就删，不进历史）
_*.py

# **下划线开头的其他临时文件也要挡。**
# `_m.txt` 是我 `git commit -F` 的输入，写完就 Remove-Item ——
# **但删的是工作区，commit 里那份还在。** 结果它被提交了 12 次，
# 还混进了"最近改了哪些文件"的统计里，看着像个重要文件。
_*.txt
_*.json
_*.sh
_sh/

# **_*.by1 也要挡。** by1instella 生成的缩小版模型、by1raw 的反例
# 都用下划线开头 —— 原来只挡了 .py/.txt/.json/.sh，于是这两个
# **是能进仓库的**（而它们每跑一次测试就会重新生成一遍）。
_*.by1
# by1raw 的断言②会把 raw.py 临时挪走再挪回来，挪走时叫这个名字。
*.by1bak

# **编译产物。** by1c / by1extdemo 会现场编 .so 和 .exe ——
# 提交它们等于每跑一次测试就往仓库里塞二进制，
# 而且 diff 永远是非人类的。
*.so
*.o
*.exe
*.dll
*.dylib
*.obj
*.pdb

# 由 by1 生成的示例，可重新生成
hello_model.py

# **`pip install -e .` 的产物。**
# README 的「装」一节就叫读者跑这条命令，而它会在仓库根留下
# `by1.egg-info/` 和 `build/` —— 这两个原来都没挡，
# 于是**照文档走一遍，`git status` 就脏了**。
# （`*.so` / `*.exe` / `cgen-*/` 都挡了，唯独漏了 pip 自己造的。）
*.egg-info/
build/
dist/
.eggs/

# 手工备份（git 接管之前的手段）
*.bak
!1.md.bak

# 从 llama.cpp 拉的参照源码（可重新下载）
llamacpp/

# **每个模型一个工作目录**（by1c --workdir cgen-<模型>）
# 原来说只挡了 `cgen/`，而并行化之后用的是 `cgen-<模型>/` ——
# 于是 8 个目录的 model.exe 全进来了。
cgen/
cgen-*/
cgen-*/*

_lh/

# ── 大文件：不该进仓库 ────────────────────────────────────────────
# refs/ 里的 **config** 和**张量名清单**要留（几十 KB，是描述的一部分），
# 但那两种大文件不留 —— 它们能重新下，而且一份几十上百 MB。
*.safetensors
*.bin
*.gguf
*.pt
*.pth
refs/*.index.json


# 删数据测试的副本 —— 和仓库里的原件是同一批字节，
# 收进来 git 会存两遍。测试的**定义**（README/MANIFEST）收在 docs/ 下。
__delete_test/files/

# 改历史之前的 .git 备份 —— **里面有旧的历史（含已删的 rc.py）**。
# 确认改完没问题之后删掉它；在那之前不能让它进任何一次提交。
.git-before-rewrite/
_rewrite.py

# 清根目录时补的
tools/remote/*.out
